{
  "name": "expense-reimbursement",
  "version": "1.0.0",
  "description": "Automated Fuel Expense Reimbursement with GPS Distance Matrix, 30km/gallon policy, and Automated Email Revert",
  "main": "server/server.js",
  "scripts": {
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.21.0",
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
