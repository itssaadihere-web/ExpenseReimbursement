# ===================================================
# EXPENSE REIMBURSEMENT - ENVIRONMENT CONFIGURATION
# ===================================================

# 1. Supabase Cloud Database & Storage (Option B)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Server Port (Default: 5000)
PORT=5000

# 3. Google Maps Matrix API Key (Optional, high-precision driving distances)
GOOGLE_MAPS_KEY=

# 4. Custom SMTP Mailer (Optional for decision notification emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=reimbursements@corporate.internal
